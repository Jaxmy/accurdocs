# accurdocs 运行配置 —— 复制为 .env 后填写（.env 勿提交 git）

# === LLM 供应商 ===
POLICYRAG_LLM=
POLICYRAG_MODEL=

# Anthropic 兼容网关（API Key 或 AUTH_TOKEN 二选一）
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=   （标准 Claude API 时用这个，留空上面的 TOKEN）

# DeepSeek（POLICYRAG_LLM=deepseek 时启用）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱 GLM（POLICYRAG_LLM=glm 时启用）
# ZHIPUAI_API_KEY=

# === 检索与路径（可留空用默认）===
POLICYRAG_EMBED=fastembed
POLICYRAG_DATA=
POLICYRAG_TRACES=
